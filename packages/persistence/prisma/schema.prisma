  templateVersion ContractTemplateVersion  @relation(fields: [templateVersionId, tenantId], references: [id, tenantId], map: "template_clauses_version_fk", onDelete: Cascade, onUpdate: NoAction)
  clauseVersion   ClauseLibraryItemVersion @relation(fields: [clauseVersionId, tenantId], references: [id, tenantId], map: "template_clauses_clause_fk", onDelete: NoAction, onUpdate: NoAction)

  @@id([templateVersionId, position])
  @@map("template_clauses")
