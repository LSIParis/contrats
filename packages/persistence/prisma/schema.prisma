  providerArticleCode String?               @map("provider_article_code")
  unitPrice           Decimal?              @map("unit_price") @db.Decimal(20, 6)
  /// { tiers, rule, formula, revision, hourPack, discount } — types du moteur.
  params              Json                  @default("{}")

  schedule PricingSchedule @relation(fields: [scheduleId, tenantId, customerId], references: [id, tenantId, customerId], map: "pricing_lines_schedule_fk", onDelete: Cascade, onUpdate: NoAction)

