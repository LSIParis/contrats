/// Version datée du barème d'un contrat. Deux versions engagées (non DRAFT)
/// d'un même contrat ne se chevauchent jamais (EXCLUDE gist, migration 21).
model PricingSchedule {
  id                String                @id @db.Uuid
  tenantId          String                @map("tenant_id") @db.Uuid
