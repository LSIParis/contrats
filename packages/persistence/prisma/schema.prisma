  createdAt           DateTime  @map("created_at")

  version   ProposalVersion   @relation(fields: [versionId, tenantId, customerId], references: [id, tenantId, customerId], map: "proposal_access_links_version_fk", onDelete: NoAction, onUpdate: NoAction)
  recipient ProposalRecipient @relation(fields: [recipientId, tenantId, customerId], references: [id, tenantId, customerId], map: "proposal_access_links_recipient_fk", onDelete: NoAction, onUpdate: NoAction)

  @@unique([id, tenantId, customerId], map: "proposal_access_links_scope_key")
  @@index([tenantId, customerId, proposalId], map: "proposal_access_links_proposal_idx")
  @@map("proposal_access_links")
}

/// Suivi DÉTAILLÉ, purgé après décision ou expiration ; IP tronquée.
model ProposalViewEvent {
  id          String                @id @db.Uuid
  tenantId    String                @map("tenant_id") @db.Uuid
  customerId  String                @map("customer_id") @db.Uuid
  proposalId  String                @map("proposal_id") @db.Uuid
  versionId   String                @map("version_id") @db.Uuid
  recipientId String?               @map("recipient_id") @db.Uuid
  linkId      String?               @map("link_id") @db.Uuid
  kind        ProposalViewEventKind
  sectionKey  String?               @map("section_key")
  durationMs  Int?                  @map("duration_ms")
  ipTruncated String?               @map("ip_truncated")
  userAgent   String?               @map("user_agent")
  occurredAt  DateTime              @map("occurred_at")

  version ProposalVersion @relation(fields: [versionId, tenantId, customerId], references: [id, tenantId, customerId], map: "proposal_view_events_version_fk", onDelete: NoAction, onUpdate: NoAction)

  @@index([tenantId, proposalId, occurredAt], map: "proposal_view_events_proposal_idx")
  @@map("proposal_view_events")
}

/// Agrégats de lecture, CONSERVÉS après la purge du détail. sectionKey '' = total.
model ProposalViewStat {
  tenantId        String    @map("tenant_id") @db.Uuid
  customerId      String    @map("customer_id") @db.Uuid
  proposalId      String    @map("proposal_id") @db.Uuid
  sectionKey      String    @default("") @map("section_key")
  opens           Int       @default(0)
  totalDurationMs BigInt    @default(0) @map("total_duration_ms")
  pdfDownloads    Int       @default(0) @map("pdf_downloads")
  newViewers      Int       @default(0) @map("new_viewers")
  lastViewedAt    DateTime? @map("last_viewed_at")

  proposal Proposal @relation(fields: [proposalId, tenantId, customerId], references: [id, tenantId, customerId], map: "proposal_view_stats_proposal_fk", onDelete: NoAction, onUpdate: NoAction)

  @@id([proposalId, sectionKey], map: "proposal_view_stats_pkey")
  @@index([tenantId, customerId], map: "proposal_view_stats_scope_idx")
  @@map("proposal_view_stats")
}

model ProposalComment {
  id           String                @id @db.Uuid
  tenantId     String                @map("tenant_id") @db.Uuid
  customerId   String                @map("customer_id") @db.Uuid
  proposalId   String                @map("proposal_id") @db.Uuid
  versionId    String                @map("version_id") @db.Uuid
  sectionKey   String?               @map("section_key")
  parentId     String?               @map("parent_id") @db.Uuid
  authorKind   ProposalCommentAuthor @map("author_kind")
  recipientId  String?               @map("recipient_id") @db.Uuid
  authorUserId String?               @map("author_user_id") @db.Uuid
  authorName   String                @map("author_name")
  body         String
  createdAt    DateTime              @map("created_at")

  version ProposalVersion   @relation(fields: [versionId, tenantId, customerId], references: [id, tenantId, customerId], map: "proposal_comments_version_fk", onDelete: NoAction, onUpdate: NoAction)
  parent  ProposalComment?  @relation("ProposalCommentReplies", fields: [parentId, tenantId, customerId], references: [id, tenantId, customerId], map: "proposal_comments_parent_fk", onDelete: NoAction, onUpdate: NoAction)
  replies ProposalComment[] @relation("ProposalCommentReplies")

  @@unique([id, tenantId, customerId], map: "proposal_comments_scope_key")
  @@index([tenantId, customerId, proposalId], map: "proposal_comments_proposal_idx")
  @@map("proposal_comments")
}

model ProposalFollowUp {
  id         String                 @id @db.Uuid
  tenantId   String                 @map("tenant_id") @db.Uuid
  customerId String                 @map("customer_id") @db.Uuid
  proposalId String                 @map("proposal_id") @db.Uuid
  kind       ProposalFollowUpKind
  dueAt      DateTime               @map("due_at")
  status     ProposalFollowUpStatus @default(PLANNED)
  sentAt     DateTime?              @map("sent_at")
  skipReason String?                @map("skip_reason")
  createdAt  DateTime               @map("created_at")
  updatedAt  DateTime               @map("updated_at")

  proposal Proposal @relation(fields: [proposalId, tenantId, customerId], references: [id, tenantId, customerId], map: "proposal_follow_ups_proposal_fk", onDelete: NoAction, onUpdate: NoAction)

  @@unique([proposalId, kind, dueAt], map: "proposal_follow_ups_plan_key")
  @@index([status, dueAt], map: "proposal_follow_ups_due_idx")
  @@map("proposal_follow_ups")
}

/// Historique des envois (append-only).
model ProposalDelivery {
  id           String               @id @db.Uuid
  tenantId     String               @map("tenant_id") @db.Uuid
  customerId   String               @map("customer_id") @db.Uuid
  proposalId   String               @map("proposal_id") @db.Uuid
  versionId    String               @map("version_id") @db.Uuid
  recipientId  String               @map("recipient_id") @db.Uuid
  kind         ProposalDeliveryKind
  subject      String
  sentByUserId String?              @map("sent_by_user_id") @db.Uuid
  error        String?
  sentAt       DateTime             @map("sent_at")

  version   ProposalVersion   @relation(fields: [versionId, tenantId, customerId], references: [id, tenantId, customerId], map: "proposal_deliveries_version_fk", onDelete: NoAction, onUpdate: NoAction)
  recipient ProposalRecipient @relation(fields: [recipientId, tenantId, customerId], references: [id, tenantId, customerId], map: "proposal_deliveries_recipient_fk", onDelete: NoAction, onUpdate: NoAction)

  @@index([tenantId, customerId, proposalId], map: "proposal_deliveries_proposal_idx")
  @@map("proposal_deliveries")
}

/// Configuration du client recalculée par le moteur (append-only ; la dernière fait foi).
model ProposalSelection {
  id                   String    @id @db.Uuid
  tenantId             String    @map("tenant_id") @db.Uuid
  customerId           String    @map("customer_id") @db.Uuid
  proposalId           String    @map("proposal_id") @db.Uuid
  versionId            String    @map("version_id") @db.Uuid
  choices              Json
  quantities           Json
  selectedOptions      Json      @map("selected_options")
  oneTimeCents         BigInt    @map("one_time_cents")
  monthlyCents         BigInt    @map("monthly_cents")
  quarterlyCents       BigInt    @map("quarterly_cents")
  yearlyCents          BigInt    @map("yearly_cents")
  commitmentTotalCents BigInt    @map("commitment_total_cents")
  commitmentMonths     Int       @map("commitment_months")
  errors               Json      @default("[]")
  actorKind            ActorKind @map("actor_kind")
  recipientId          String?   @map("recipient_id") @db.Uuid
  userId               String?   @map("user_id") @db.Uuid
  createdAt            DateTime  @map("created_at")

  version   ProposalVersion   @relation(fields: [versionId, tenantId, customerId], references: [id, tenantId, customerId], map: "proposal_selections_version_fk", onDelete: NoAction, onUpdate: NoAction)
  snapshots PricingSnapshot[]

  @@unique([id, tenantId, customerId], map: "proposal_selections_scope_key")
  @@index([tenantId, versionId, createdAt], map: "proposal_selections_version_idx")
  @@map("proposal_selections")
}

/// PricingSnapshot : configuration FIGÉE à l'acceptation, reprise comme barème initial du contrat. Immuable.
model PricingSnapshot {
  id                   String   @id @db.Uuid
  tenantId             String   @map("tenant_id") @db.Uuid
  customerId           String   @map("customer_id") @db.Uuid
  proposalId           String   @map("proposal_id") @db.Uuid
  versionId            String   @map("version_id") @db.Uuid
  selectionId          String   @map("selection_id") @db.Uuid
  definition           Json
  selection            Json
  /// PricingSchedule du moteur (@lsi/pricing), exactement celui qui a été calculé.
  engineSchedule       Json     @map("engine_schedule")
  engineResult         Json     @map("engine_result")
  oneTimeCents         BigInt   @map("one_time_cents")
  monthlyCents         BigInt   @map("monthly_cents")
  commitmentTotalCents BigInt   @map("commitment_total_cents")
  commitmentMonths     Int      @map("commitment_months")
  sha256               String   @db.Char(64)
  createdAt            DateTime @map("created_at")

  version           ProposalVersion            @relation(fields: [versionId, tenantId, customerId], references: [id, tenantId, customerId], map: "pricing_snapshots_version_fk", onDelete: NoAction, onUpdate: NoAction)
  selectionRow      ProposalSelection          @relation(fields: [selectionId, tenantId, customerId], references: [id, tenantId, customerId], map: "pricing_snapshots_selection_fk", onDelete: NoAction, onUpdate: NoAction)
  acceptances       ProposalAcceptance[]
  signatureRequests ProposalSignatureRequest[]

  @@unique([id, tenantId, customerId], map: "pricing_snapshots_scope_key")
  @@index([tenantId, customerId, proposalId], map: "pricing_snapshots_proposal_idx")
  @@map("pricing_snapshots")
}

/// Preuve d'acceptation (append-only) ; CLICK_ACCEPT exige un e-mail vérifié par code (CHECK).
model ProposalAcceptance {
  id                 String                 @id @db.Uuid
  tenantId           String                 @map("tenant_id") @db.Uuid
  customerId         String                 @map("customer_id") @db.Uuid
  proposalId         String                 @map("proposal_id") @db.Uuid
  versionId          String                 @map("version_id") @db.Uuid
  snapshotId         String                 @map("snapshot_id") @db.Uuid
  recipientId        String?                @map("recipient_id") @db.Uuid
  mode               ProposalAcceptanceMode
  acceptedByName     String                 @map("accepted_by_name")
  acceptedByFunction String?                @map("accepted_by_function")
  acceptedByEmail    String                 @map("accepted_by_email")
  emailVerifiedAt    DateTime?              @map("email_verified_at")
  ip                 String?
  userAgent          String?                @map("user_agent")
  versionPdfSha256   String?                @map("version_pdf_sha256") @db.Char(64)
  acceptedAt         DateTime               @map("accepted_at")

  version  ProposalVersion @relation(fields: [versionId, tenantId, customerId], references: [id, tenantId, customerId], map: "proposal_acceptances_version_fk", onDelete: NoAction, onUpdate: NoAction)
  snapshot PricingSnapshot @relation(fields: [snapshotId, tenantId, customerId], references: [id, tenantId, customerId], map: "proposal_acceptances_snapshot_fk", onDelete: NoAction, onUpdate: NoAction)

  @@index([tenantId, customerId, proposalId], map: "proposal_acceptances_proposal_idx")
  @@map("proposal_acceptances")
}

/// Soumission DocuSeal d'une proposition (même adaptateur, même pipeline de webhooks).
model ProposalSignatureRequest {
  id                   String                 @id @db.Uuid
  tenantId             String                 @map("tenant_id") @db.Uuid
  customerId           String                 @map("customer_id") @db.Uuid
  proposalId           String                 @map("proposal_id") @db.Uuid
  versionId            String                 @map("version_id") @db.Uuid
  snapshotId           String                 @map("snapshot_id") @db.Uuid
  provider             SignatureProvider      @default(DOCUSEAL)
  providerSubmissionId String?                @map("provider_submission_id")
  status               SignatureRequestStatus @default(CREATING)
  idempotencyKey       String                 @unique(map: "proposal_signature_requests_idempotency_key") @map("idempotency_key")
  expireAt             DateTime?              @map("expire_at")
  delivery             SignatureDelivery      @default(EMBEDDED)
  signingOrder         String?                @map("signing_order")
  sentPdfObjectKey     String?                @map("sent_pdf_object_key")
  sentPdfSha256        String?                @map("sent_pdf_sha256") @db.Char(64)
  signedPdfObjectKey   String?                @map("signed_pdf_object_key")
  signedPdfSha256      String?                @map("signed_pdf_sha256") @db.Char(64)
  auditTrailObjectKey  String?                @map("audit_trail_object_key")
  auditTrailSha256     String?                @map("audit_trail_sha256") @db.Char(64)
  hashRelation         HashRelation?          @map("hash_relation")
  lastSyncedAt         DateTime?              @map("last_synced_at")
  errorMessage         String?                @map("error_message")
  createdAt            DateTime               @map("created_at")
  updatedAt            DateTime               @map("updated_at")
  createdByUserId      String?                @map("created_by_user_id") @db.Uuid

  version  ProposalVersion          @relation(fields: [versionId, tenantId, customerId], references: [id, tenantId, customerId], map: "proposal_signature_requests_version_fk", onDelete: NoAction, onUpdate: NoAction)
  snapshot PricingSnapshot          @relation(fields: [snapshotId, tenantId, customerId], references: [id, tenantId, customerId], map: "proposal_signature_requests_snapshot_fk", onDelete: NoAction, onUpdate: NoAction)
  signers  ProposalSigner[]
  events   ProposalSignatureEvent[]

  @@unique([id, tenantId, customerId], map: "proposal_signature_requests_scope_key")
  @@unique([provider, providerSubmissionId], map: "proposal_signature_requests_submission_key")
  @@index([tenantId, customerId, proposalId], map: "proposal_signature_requests_proposal_idx")
  @@map("proposal_signature_requests")
}

model ProposalSigner {
  id                    String       @id @db.Uuid
  tenantId              String       @map("tenant_id") @db.Uuid
  customerId            String       @map("customer_id") @db.Uuid
  proposalId            String       @map("proposal_id") @db.Uuid
  signatureRequestId    String       @map("signature_request_id") @db.Uuid
  party                 SignerParty
  recipientId           String?      @map("recipient_id") @db.Uuid
  userId                String?      @map("user_id") @db.Uuid
  fullName              String       @map("full_name")
  email                 String
  signingOrder          Int          @default(0) @map("signing_order")
  status                SignerStatus @default(PENDING)
  providerSubmitterId   String?      @unique(map: "proposal_signers_submitter_key") @map("provider_submitter_id")
  providerSubmitterSlug String?      @map("provider_submitter_slug")
  embedSrc              String?      @map("embed_src")
  signedAt              DateTime?    @map("signed_at")
  declinedAt            DateTime?    @map("declined_at")
  declineReason         String?      @map("decline_reason")
  createdAt             DateTime     @map("created_at")
  updatedAt             DateTime     @map("updated_at")

  signatureRequest ProposalSignatureRequest @relation(fields: [signatureRequestId, tenantId, customerId], references: [id, tenantId, customerId], map: "proposal_signers_request_fk", onDelete: NoAction, onUpdate: NoAction)

  @@index([tenantId, customerId, signatureRequestId], map: "proposal_signers_request_idx")
  @@map("proposal_signers")
}

model ProposalSignatureEvent {
  id                 String             @id @db.Uuid
  tenantId           String             @map("tenant_id") @db.Uuid
  customerId         String             @map("customer_id") @db.Uuid
  proposalId         String             @map("proposal_id") @db.Uuid
  signatureRequestId String             @map("signature_request_id") @db.Uuid
  providerEventId    String             @unique(map: "proposal_signature_events_event_key") @map("provider_event_id")
  eventType          SignatureEventType @map("event_type")
  submitterEmail     String?            @map("submitter_email")
  occurredAt         DateTime           @map("occurred_at")
  receivedAt         DateTime           @map("received_at")
  rawPayload         Json               @map("raw_payload")
  processedAt        DateTime?          @map("processed_at")

  signatureRequest ProposalSignatureRequest @relation(fields: [signatureRequestId, tenantId, customerId], references: [id, tenantId, customerId], map: "proposal_signature_events_request_fk", onDelete: NoAction, onUpdate: NoAction)

  @@index([tenantId, customerId, signatureRequestId], map: "proposal_signature_events_request_idx")
  @@map("proposal_signature_events")
}
