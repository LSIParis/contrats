/// Référentiel unique des fichiers. ÉCRITURE UNIQUE : UPDATE/DELETE révoqués
/// au rôle applicatif. Pas d'updatedAt : son absence documente l'immuabilité.
model StoredDocument {
  id               String               @id @db.Uuid
  tenantId         String               @map("tenant_id") @db.Uuid
  customerId       String               @map("customer_id") @db.Uuid
  contractId       String?              @map("contract_id") @db.Uuid
  kind             StoredDocumentKind
  origin           StoredDocumentOrigin
  objectKey        String               @unique @map("object_key")
  filename         String
  contentType      String               @map("content_type")
  sizeBytes        BigInt               @map("size_bytes")
  /// Empreinte du fichier tel que reçu/produit : fonde la valeur probante.
  sha256           String               @db.Char(64)
  /// Copie OCR → original dont elle dérive.
  derivedFromId    String?              @map("derived_from_id") @db.Uuid
  uploadedByUserId String?              @map("uploaded_by_user_id") @db.Uuid
  createdAt        DateTime             @map("created_at")

  customer    Customer         @relation(fields: [customerId, tenantId], references: [id, tenantId], map: "stored_documents_customer_fk", onDelete: NoAction, onUpdate: NoAction)
  contract    Contract?        @relation(fields: [contractId, tenantId, customerId], references: [id, tenantId, customerId], map: "stored_documents_contract_fk", onDelete: NoAction, onUpdate: NoAction)
  derivedFrom StoredDocument?  @relation("Derivation", fields: [derivedFromId, tenantId, customerId], references: [id, tenantId, customerId], map: "stored_documents_derived_fk", onDelete: NoAction, onUpdate: NoAction)
  derivatives StoredDocument[] @relation("Derivation")

  importsAsOriginal ContractImport[] @relation("ImportOriginal")
  importsAsOcrPdf   ContractImport[] @relation("ImportOcrPdf")
  importsAsOcrText  ContractImport[] @relation("ImportOcrText")

  @@unique([id, tenantId, customerId], map: "stored_documents_scope_key")
  @@index([tenantId, customerId, contractId], map: "stored_documents_contract_idx")
  @@index([tenantId, sha256], map: "stored_documents_sha_idx")
  @@map("stored_documents")
}

