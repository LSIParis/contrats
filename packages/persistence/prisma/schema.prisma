// Schéma de données — LSI Contrats
// Référence : docs/superpowers/specs/2026-07-16-gestion-contrats-msp-design.md §8
//
// TROIS CLASSES DE TABLES, et c'est la distinction la plus importante du modèle :
//
//   plateforme  → aucun scope             : tenants
//   tenant      → tenant_id               : users, roles, customers, contract_templates
//   customer    → tenant_id + customer_id : tout le reste
//
// customer_id est DÉNORMALISÉ sur toutes les tables filles, y compris là où il
// serait dérivable via contract_id. Redondance assumée : une politique RLS qui
// doit joindre pour connaître le scope d'une ligne est lente et fragile. Le
// scope doit être lisible sur la ligne elle-même.
//
// La cohérence est garantie par des FK COMPOSITES (§8.4) : sans elles, on
// pourrait insérer un commentaire portant le customer_id de A sur un contrat
// de B. La ligne serait visible de A tout en parlant du contrat de B, et RLS
// n'y verrait rien à redire — elle vérifie le scope, pas la cohérence.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===========================================================================
// Énumérations
// ===========================================================================

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

/// RM-32 : un compte est interne OU client, jamais les deux.
enum UserKind {
  INTERNAL
  CLIENT
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum RoleCode {
  MSP_ADMIN
  ACCOUNT_MANAGER
  LEGAL_REVIEWER
  TECHNICIAN
  CLIENT_SIGNER
  CLIENT_VIEWER
  /// Signataire interne (brief : signataire_interne). Portée tous clients.
  INTERNAL_SIGNATORY
  /// Lecteur (brief : lecteur). Portée portefeuille, lecture seule.
  READER
}

enum CustomerStatus {
  ACTIVE
  ARCHIVED
}

enum TemplateStatus {
  DRAFT
  PUBLISHED
  DEPRECATED
}

enum ContractCategory {
  MAINTENANCE
  SUPPORT
  HOSTING
  SLA
  OTHER
}

enum ContractType {
  MAIN
  AMENDMENT
}

enum ContractOrigin {
  NATIVE
  IMPORTED
  /// Projet rédigé par IA (brief §6) : revue humaine clause par clause.
  AI
  /// Né d'une proposition signée (lot 9, brief §12.7).
  PROPOSAL
}

/// §7.1. EXPIRING_SOON et ARCHIVED n'en font PAS partie :
///   - EXPIRING_SOON est dérivé de end_date (RM-02) — un état que seul un job
///     saurait produire ferait dépendre la vérité métier du scheduler.
///   - ARCHIVED est l'attribut archived_at (RM-03), orthogonal au cycle de vie.
enum ContractStatus {
  DRAFT
  IN_REVIEW
  CHANGES_REQUESTED
  APPROVED
  PENDING_SIGNATURE
  PARTIALLY_SIGNED
  SIGNED
  ACTIVE
  EXPIRED
  TERMINATED
  RENEWED
  CANCELLED
  DECLINED
  // v2 — docs/contrats/02-cycle-de-vie.md (migrations 18-19)
  SENT_TO_CLIENT
  IN_NEGOTIATION
  ACCEPTED
  SIGNATURE_EXPIRED
  RENEWAL_DUE
  TERMINATION_PENDING
  IMPORTED_PENDING_VALIDATION
}

/// Reconduction (V2-H10). NONE = le contrat expire à son terme.
enum RenewalMode {
  NONE
  TACIT
  EXPRESS
}

enum AcceptanceMethod {
  PORTAL
  RECORDED_BY_STAFF
}

enum ContractPeriodKind {
  INITIAL
  TACIT_RENEWAL
  EXPRESS_RENEWAL
}

enum BillingFrequency {
  MONTHLY
  QUARTERLY
  YEARLY
  ONE_OFF
}

enum ApprovalDecision {
  PENDING
  APPROVED
  CHANGES_REQUESTED
}

enum SignerParty {
  LSI
  CLIENT
}

enum SignerStatus {
  PENDING
  SENT
  VIEWED
  SIGNED
  DECLINED
}

/// Énuméré dès le MVP alors qu'il n'y a qu'une valeur : deux caractères
/// aujourd'hui contre une migration de données le jour où un client grand
/// compte exigera une signature avancée eIDAS (§11.1).
enum SignatureProvider {
  DOCUSEAL
}

enum SignatureRequestStatus {
  CREATING
  SENT
  PARTIALLY_COMPLETED
  COMPLETED
  DECLINED
  EXPIRED
  REVOKED
  FAILED
}

/// Lot 4 (migration 24) : voie de création de la soumission DocuSeal.
enum SignatureMode {
  PDF
  TEMPLATE
}

/// Remise : lien par e-mail ou signature intégrée (embed_src).
enum SignatureDelivery {
  EMAIL
  EMBEDDED
}

/// Lien entre l'empreinte envoyée et celle du document signé rapatrié.
enum HashRelation {
  IDENTICAL
  SIGNED_OVERLAY
}

enum SignatureEventType {
  FORM_VIEWED
  FORM_STARTED
  FORM_COMPLETED
  FORM_DECLINED
  SUBMISSION_COMPLETED
  SUBMISSION_EXPIRED
}

/// Le défaut est INTERNAL (§6.10). C'est le risque de fuite le plus banal
/// et le plus probable de toute l'application.
enum CommentVisibility {
  INTERNAL
  SHARED
}

enum VirusScanStatus {
  PENDING
  CLEAN
  INFECTED
}

enum ReminderKind {
  EXPIRY
  NOTICE_DEADLINE
  // Échéancier v2 (migration 20)
  PRICE_REVISION
  RENEWAL_DECISION
  CHATEL_NOTICE
  TERMINATION_EFFECTIVE
}

enum OcrStatus {
  PENDING
  RUNNING
  DONE
  FAILED
  SKIPPED
}

enum DeadlineKind {
  PERIOD_END
  NOTICE_DEADLINE
  PRICE_REVISION
  RENEWAL_DECISION
  CHATEL_NOTICE
  TERMINATION_EFFECTIVE
}

enum DeadlineStatus {
  OPEN
  DONE
  OBSOLETE
}

enum ClauseCategory {
  OBJET
  DUREE
  PRIX
  SLA
  RESPONSABILITE
  RGPD
  CONFIDENTIALITE
  PROPRIETE_INTELLECTUELLE
  ASSURANCE
  RESILIATION
  DIVERS
}

enum ClauseOrigin {
  TEMPLATE
  LIBRARY
  CUSTOM
  AI
}

enum ClauseRisk {
  LOW
  MEDIUM
  HIGH
}

enum AnnexKind {
  SLA
  ASSETS
  PRICING_GRID
  DPA_ART28
  OTHER
}

enum ClauseReviewDecision {
  APPROVED
  REJECTED
}

enum ReminderStatus {
  PENDING
  SENT
  SKIPPED_OBSOLETE
  CANCELLED
  FAILED
}

enum NotificationChannel {
  IN_APP
  EMAIL
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
  READ
}

enum ActorKind {
  INTERNAL
  CLIENT
  SYSTEM
}

enum RenewalStatus {
  PENDING
  ACCEPTED
  REFUSED
  EXPIRED
}

enum CancellationType {
  CANCELLATION
  TERMINATION
}

enum InitiatedBy {
  LSI
  CLIENT
}

/// Nature d'un fichier stocké (migration 17).
enum StoredDocumentKind {
  LEGACY_SCAN
  OCR_TEXT
  OCR_PDF
  CONTRACT_PDF
  SIGNED_PDF
  SIGNATURE_AUDIT_TRAIL
  TERMINATION_LETTER
  ATTACHMENT
  // Lot 9 (migration 30)
  PROPOSAL_PDF
  PROPOSAL_SIGNED_PDF
  PROPOSAL_AUDIT_TRAIL
}

enum StoredDocumentOrigin {
  UPLOAD
  GENERATED
  DOCUSEAL
  OCR
}

// ===========================================================================
// Classe « plateforme »
// ===========================================================================

model Tenant {
  id        String       @id @db.Uuid
  name      String
  slug      String       @unique
  status    TenantStatus @default(ACTIVE)
  createdAt DateTime     @map("created_at")
  updatedAt DateTime     @map("updated_at")

  users        User[]
  roles        Role[]
  customers    Customer[]
  templates    ContractTemplate[]
  contracts    Contract[]
  featureFlags TenantFeatureFlag[]
  settings     TenantSetting[]
  clauseItems  ClauseLibraryItem[]
  priceIndexes PriceIndex[]
  aiUsage      AiUsage[]
  apiClients   ApiClient[]
  apiCalls     ApiCallLog[]
  pricingRules PricingRule[]

  // Lot 9 — propositions (classe « tenant »)
  contentLibraryItems ContentLibraryItem[]
  proposalTerms       ProposalTerms[]
  proposalTemplates   ProposalTemplate[]
  proposalSequences   ProposalSequence[]

  webhookSubscriptions WebhookSubscription[]
  webhookEvents        WebhookEvent[]

  @@map("tenants")
}

// ===========================================================================
// Classe « tenant »
// ===========================================================================

model User {
  id             String     @id @db.Uuid
  tenantId       String     @map("tenant_id") @db.Uuid
  kind           UserKind
  /// NULL si INTERNAL, NOT NULL si CLIENT. Contrainte CHECK en migration (RM-32).
  /// Non modifiable après création : la session client est épinglée (RM-31).
  customerId     String?    @map("customer_id") @db.Uuid
  email          String
  fullName       String     @map("full_name")
  status         UserStatus @default(ACTIVE)
  /// Sujet OIDC Entra ID (H6).
  externalIdpSub String?    @map("external_idp_sub")
  lastLoginAt    DateTime?  @map("last_login_at")
  createdAt      DateTime   @map("created_at")
  updatedAt      DateTime   @map("updated_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  customer Customer? @relation("ClientUsers", fields: [customerId, tenantId], references: [id, tenantId])

  roles          UserRole[]
  customerAccess CustomerAccess[] @relation("AccessUser")
  grantedAccess  CustomerAccess[] @relation("AccessGrantedBy")
  notifications  Notification[]
  comments       Comment[]
  ownedProposals Proposal[]       @relation("ProposalOwner")

  @@unique([tenantId, email])
  @@unique([id, tenantId])
  @@index([tenantId, kind])
  @@map("users")
}

model Role {
  id       String   @id @db.Uuid
  tenantId String   @map("tenant_id") @db.Uuid
  code     RoleCode
  label    String

  tenant Tenant     @relation(fields: [tenantId], references: [id])
  users  UserRole[]

  @@unique([tenantId, code])
  @@unique([id, tenantId])
  @@map("roles")
}

model UserRole {
  tenantId String @map("tenant_id") @db.Uuid
  userId   String @map("user_id") @db.Uuid
  roleId   String @map("role_id") @db.Uuid

  user User @relation(fields: [userId, tenantId], references: [id, tenantId], onDelete: Cascade)
  role Role @relation(fields: [roleId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([tenantId])
  @@map("user_roles")
}

/// LE PORTEFEUILLE. La table la plus sensible de l'application :
/// elle définit qui voit quoi côté interne (§10.4).
///
/// MSP_ADMIN et LEGAL_REVIEWER n'y ont PAS de lignes — ils portent un accès
/// all_customers implicite, résolu à l'ouverture de session.
model CustomerAccess {
  tenantId         String   @map("tenant_id") @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  customerId       String   @map("customer_id") @db.Uuid
  grantedByUserId  String   @map("granted_by_user_id") @db.Uuid
  grantedAt        DateTime @map("granted_at")

  user      User     @relation("AccessUser", fields: [userId, tenantId], references: [id, tenantId], onDelete: Cascade)
  grantedBy User     @relation("AccessGrantedBy", fields: [grantedByUserId, tenantId], references: [id, tenantId])
  customer  Customer @relation(fields: [customerId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@id([userId, customerId])
  @@index([userId])
  @@index([tenantId, customerId])
  @@map("customer_access")
}

model Customer {
  id           String         @id @db.Uuid
  tenantId     String         @map("tenant_id") @db.Uuid
  name         String
  legalName    String?        @map("legal_name")
  siren        String?        @db.Char(9)
  vatNumber    String?        @map("vat_number")
  addressLine1 String?        @map("address_line1")
  addressLine2 String?        @map("address_line2")
  postalCode   String?        @map("postal_code")
  city         String?
  country      String         @default("FR") @db.Char(2)
  status       CustomerStatus @default(ACTIVE)
  notes        String?
  createdAt    DateTime       @map("created_at")
  updatedAt    DateTime       @map("updated_at")
  /// Consommateur ou non-professionnel : obligation d'information Chatel.
  isConsumer   Boolean        @default(false) @map("is_consumer")
  /// Référence du client dans Client Help (ou saisie locale).
  externalRef  String?        @map("external_ref")
  /// Lot 9 : PROSPECT → CLIENT à la signature de la première proposition.
  commercialStatus CustomerCommercialStatus @default(CLIENT) @map("commercial_status")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  contacts      CustomerContact[]
  contracts     Contract[]
  clientUsers   User[]            @relation("ClientUsers")
  access        CustomerAccess[]
  documents     StoredDocument[]
  proposals     Proposal[]

  /// Clé candidate composite : cible des FK porteuses de scope (§8.4).
  @@unique([id, tenantId])
  @@unique([tenantId, siren])
  @@unique([tenantId, externalRef], map: "customers_tenant_external_ref_key")
  @@index([tenantId, status])
  @@map("customers")
}

model CustomerContact {
  id          String   @id @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  customerId  String   @map("customer_id") @db.Uuid
  firstName   String   @map("first_name")
  lastName    String   @map("last_name")
  email       String
  phone       String?
  jobTitle    String?  @map("job_title")
  isSignatory Boolean  @default(false) @map("is_signatory")
  /// Qualité à signer (gérant, président, DG, mandataire…).
  signingCapacity String? @map("signing_capacity")
  isPrimary   Boolean  @default(false) @map("is_primary")
  createdAt   DateTime @map("created_at")
  updatedAt   DateTime @map("updated_at")

  customer Customer         @relation(fields: [customerId, tenantId], references: [id, tenantId], onDelete: Cascade)
  signers  ContractSigner[]
  proposalRecipients ProposalRecipient[]

  @@unique([customerId, email])
  @@unique([id, tenantId, customerId])
  @@index([tenantId, customerId])
  @@map("customer_contacts")
}

/// Les modèles sont au niveau TENANT, pas customer (H10) : ils sont
/// mutualisés entre clients. Seules les INSTANCES de contrats sont cloisonnées.
model ContractTemplate {
  id               String           @id @db.Uuid
  tenantId         String           @map("tenant_id") @db.Uuid
  name             String
  category         ContractCategory @default(MAINTENANCE)
  status           TemplateStatus   @default(DRAFT)
  currentVersionId String?          @map("current_version_id") @db.Uuid
  createdAt        DateTime         @map("created_at")
  updatedAt        DateTime         @map("updated_at")
  /// Exemple fourni avec l'application : affiché « DÉMONSTRATION » (brief §4).
  isDemo           Boolean          @default(false) @map("is_demo")
  /// Lot 9 : identifiant stable, cible de `proposal_templates.contract_template_slug`.
  slug             String?

  tenant   Tenant                    @relation(fields: [tenantId], references: [id])
  versions ContractTemplateVersion[]

  @@unique([id, tenantId])
  @@unique([tenantId, slug], map: "contract_templates_slug_key")
  @@index([tenantId, status])
  @@map("contract_templates")
}

model ContractTemplateVersion {
  id                String   @id @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  templateId        String   @map("template_id") @db.Uuid
  versionNumber     Int      @map("version_number")
  bodyHtml          String   @map("body_html")
  /// JSON Schema des variables attendues.
  variablesSchema   Json     @map("variables_schema")
  docusealTemplateId Int?    @map("docuseal_template_id")
  publishedAt       DateTime? @map("published_at")
  publishedByUserId String?  @map("published_by_user_id") @db.Uuid
  isImmutable       Boolean  @default(false) @map("is_immutable")
  createdAt         DateTime @map("created_at")
  /// Annexes par défaut [{ kind, title, bodyHtml }], copiées dans chaque contrat.
  defaultAnnexes    Json     @default("[]") @map("default_annexes")
  /// Barème par défaut (lignes @lsi/pricing), repris par la tarification.
  defaultPricing    Json     @default("[]") @map("default_pricing")

  template  ContractTemplate @relation(fields: [templateId, tenantId], references: [id, tenantId], onDelete: Cascade)
  contracts Contract[]
  clauses   TemplateClause[]

  @@unique([templateId, versionNumber])
  @@unique([id, tenantId])
  @@map("contract_template_versions")
}

// ===========================================================================
// Classe « customer » — tout ce qui suit porte tenant_id + customer_id
// ===========================================================================

model Contract {
  id         String  @id @db.Uuid
  tenantId   String  @map("tenant_id") @db.Uuid
  /// LA FRONTIÈRE D'ISOLATION.
  customerId String  @map("customer_id") @db.Uuid

  reference String
  title     String
  type      ContractType     @default(MAIN)
  status    ContractStatus   @default(DRAFT)
  category  ContractCategory @default(MAINTENANCE)

  /// Provenance : NATIVE (créé dans l'app) vs IMPORTED (enregistré depuis
  /// l'existant, signé hors application — pas de preuve DocuSeal).
  origin ContractOrigin @default(NATIVE)

  /// Document importé (PDF/DOCX signé hors app). NULL pour un contrat NATIVE.
  importedDocumentKey         String? @map("imported_document_key")
  importedDocumentName        String? @map("imported_document_name")
  importedDocumentSha256      String? @map("imported_document_sha256") @db.Char(64)
  importedDocumentContentType String? @map("imported_document_content_type")

  /// Référence FIGÉE vers la version de modèle utilisée. NULL si from scratch.
  /// Savoir quel texte type a servi est indispensable en litige.
  templateVersionId String? @map("template_version_id") @db.Uuid
  currentVersionId  String? @map("current_version_id") @db.Uuid
  /// RM-11 : une validation porte sur une VERSION, jamais sur un contrat.
  approvedVersionId String? @map("approved_version_id") @db.Uuid

  /// Avenant → contrat parent (RM-17).
  parentContractId      String? @map("parent_contract_id") @db.Uuid
  /// Renouvellement (RM-16).
  predecessorContractId String? @map("predecessor_contract_id") @db.Uuid
  successorContractId   String? @map("successor_contract_id") @db.Uuid

  startDate        DateTime? @map("start_date") @db.Date
  /// NULL = durée indéterminée (EC-13).
  endDate          DateTime? @map("end_date") @db.Date
  noticePeriodDays Int?      @map("notice_period_days")

  /// Entier, JAMAIS un flottant : on ne stocke pas de la monnaie en float.
  amountCents      BigInt?          @map("amount_cents")
  currency         String           @default("EUR") @db.Char(3)
  billingFrequency BillingFrequency @default(MONTHLY) @map("billing_frequency")

  /// Intention DOCUMENTAIRE seulement. Ne déclenche AUCUNE action (RM-21) :
  /// reconduire silencieusement une obligation contractuelle depuis un cron
  /// est un risque juridique que l'application refuse de porter.
  autoRenewIntent Boolean @default(false) @map("auto_renew_intent")

  /// Incrémenté à chaque régénération de rappels (EC-12).
  reminderCycle Int @default(0) @map("reminder_cycle")

  // --- v2 (migrations 18-19) ----------------------------------------------------
  /// V2-ACC : version acceptée par le client, distincte de la signature.
  acceptedVersionId        String?     @map("accepted_version_id") @db.Uuid
  renewalMode              RenewalMode @default(NONE) @map("renewal_mode")
  renewalPeriodMonths      Int?        @map("renewal_period_months")
  /// Préavis en mois (exclusif de noticePeriodDays, CHECK en base).
  noticePeriodMonths       Int?        @map("notice_period_months")
  /// null = déduit du client (isConsumer) ; true/false = forcé.
  chatelNotice             Boolean?    @map("chatel_notice")
  terminationEffectiveDate DateTime?   @map("termination_effective_date") @db.Date
  /// Clauses IA pas encore validées par un humain (V2-AI).
  unreviewedAiClauses      Int         @default(0) @map("unreviewed_ai_clauses")
  /// Variables du contrat type encore sans valeur (V2-VAR, migration 22).
  missingVariables         Int         @default(0) @map("missing_variables")
  /// Lot 9 : proposition signée dont ce contrat est issu (UNIQUE : conversion idempotente).
  proposalId               String?     @unique(map: "contracts_proposal_key") @map("proposal_id") @db.Uuid
  /// Proposition signée valant contrat (signedProposalIsContract) : signatureMode dérivé PROPOSAL_SIGNED.
  signedViaProposal        Boolean     @default(false) @map("signed_via_proposal")

  signedAt     DateTime? @map("signed_at")
  activatedAt  DateTime? @map("activated_at")
  terminatedAt DateTime? @map("terminated_at")
  /// RM-03 : attribut orthogonal, pas un statut.
  archivedAt   DateTime? @map("archived_at")

  ownerUserId     String   @map("owner_user_id") @db.Uuid
  createdAt       DateTime @map("created_at")
  updatedAt       DateTime @map("updated_at")
  createdByUserId String   @map("created_by_user_id") @db.Uuid
  updatedByUserId String   @map("updated_by_user_id") @db.Uuid

  /// Recherche plein texte : colonne GÉNÉRÉE par PostgreSQL (migration 4),
  /// jamais écrite par l'application. Déclarée ici uniquement pour que le
  /// contrôle de dérive (db:check-drift) la reconnaisse.
  searchVector Unsupported("tsvector")? @default(dbgenerated()) @map("search_vector")

  tenant          Tenant                   @relation(fields: [tenantId], references: [id])
  customer        Customer                 @relation(fields: [customerId, tenantId], references: [id, tenantId])
  templateVersion ContractTemplateVersion? @relation(fields: [templateVersionId, tenantId], references: [id, tenantId])

  parentContract Contract?  @relation("Amendments", fields: [parentContractId], references: [id])
  amendments     Contract[] @relation("Amendments")

  versions          ContractVersion[]
  signers           ContractSigner[]
  approvals         ContractApproval[]
  signatureRequests SignatureRequest[]
  comments          Comment[]
  attachments       Attachment[]
  reminders         Reminder[]
  renewalRequests   RenewalRequest[]  @relation("ParentContract")
  cancellations     Cancellation[]
  storedDocuments   StoredDocument[]
  lifecycleEvents   LifecycleEvent[]
  acceptances       ContractAcceptance[]
  periods           ContractPeriod[]
  imports           ContractImport[]
  deadlines         Deadline[]
  clauses           ContractClause[]
  clauseReviews     ContractClauseReview[]
  annexes           Annex[]
  pricingSchedules  PricingSchedule[]
  priceOverrides    PriceOverride[]

  proposal           Proposal?  @relation("ContractFromProposal", fields: [proposalId, tenantId, customerId], references: [id, tenantId, customerId], map: "contracts_proposal_fk", onDelete: NoAction, onUpdate: NoAction)
  proposalsConverted Proposal[] @relation("ProposalGeneratedContract")

  /// Clé candidate composite portant le scope complet : cible de TOUTES
  /// les FK des tables filles (§8.4).
  @@unique([id, tenantId, customerId])
  @@unique([tenantId, reference])
  @@index([tenantId, customerId, status])
  @@index([tenantId, customerId, endDate])
  @@index([tenantId, ownerUserId, status])
  @@index([tenantId, customerId, archivedAt])
  @@index([searchVector], map: "contracts_search_idx", type: Gin)
  @@map("contracts")
}

/// IMMUABLES. Aucun updatedAt : l'absence de cette colonne EST la
/// documentation de l'immuabilité. UPDATE/DELETE révoqués en migration.
model ContractVersion {
  id            String   @id @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  customerId    String   @map("customer_id") @db.Uuid
  contractId    String   @map("contract_id") @db.Uuid
  versionNumber Int      @map("version_number")
  bodyHtml      String   @map("body_html")
  variables     Json
  pdfObjectKey  String?  @map("pdf_object_key")
  /// Calculé AVANT envoi : c'est ce qui permet d'affirmer plus tard
  /// « le document envoyé est exactement celui-ci » (§11.2).
  pdfSha256     String?  @map("pdf_sha256") @db.Char(64)
  changeSummary String?  @map("change_summary")
  createdAt     DateTime @map("created_at")
  createdByUserId String @map("created_by_user_id") @db.Uuid

  contract    Contract             @relation(fields: [contractId, tenantId, customerId], references: [id, tenantId, customerId], onDelete: Cascade)
  acceptances ContractAcceptance[]
  clauses     ContractClause[]
  annexes     Annex[]

  @@unique([contractId, versionNumber])
  @@unique([id, tenantId, customerId])
  @@index([tenantId, customerId, contractId])
  @@map("contract_versions")
}

model ContractSigner {
