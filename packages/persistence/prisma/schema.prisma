/// Clause d'une VERSION de contrat — figée avec elle (écriture unique).
model ContractClause {
  id                    String         @id @db.Uuid
  tenantId              String         @map("tenant_id") @db.Uuid
  customerId            String         @map("customer_id") @db.Uuid
  contractId            String         @map("contract_id") @db.Uuid
  versionId             String         @map("version_id") @db.Uuid
  position              Int
  /// Identifiant STABLE d'une version à l'autre (diff, revue IA).
  clauseKey             String         @map("clause_key")
  category              ClauseCategory
  title                 String
  bodyHtml              String         @map("body_html")
  origin                ClauseOrigin
  sourceClauseVersionId String?        @map("source_clause_version_id") @db.Uuid
  aiRisk                ClauseRisk?    @map("ai_risk")
  aiJustification       String?        @map("ai_justification")
  aiSources             Json?          @map("ai_sources")

  version  ContractVersion        @relation(fields: [versionId, tenantId, customerId], references: [id, tenantId, customerId], map: "contract_clauses_version_fk", onDelete: NoAction, onUpdate: NoAction)
  contract Contract               @relation(fields: [contractId, tenantId, customerId], references: [id, tenantId, customerId], map: "contract_clauses_contract_fk", onDelete: NoAction, onUpdate: NoAction)
  reviews  ContractClauseReview[]

  @@unique([versionId, position], map: "contract_clauses_position_key")
  @@unique([versionId, clauseKey], map: "contract_clauses_key_key")
  @@unique([id, tenantId, customerId], map: "contract_clauses_scope_key")
  @@index([tenantId, customerId, contractId], map: "contract_clauses_contract_idx")
  @@map("contract_clauses")
}

/// Revue humaine d'une clause (obligatoire pour les clauses IA). Append-only.
model ContractClauseReview {
  id               String               @id @db.Uuid
  tenantId         String               @map("tenant_id") @db.Uuid
  customerId       String               @map("customer_id") @db.Uuid
  contractId       String               @map("contract_id") @db.Uuid
  clauseId         String               @map("clause_id") @db.Uuid
  decision         ClauseReviewDecision
  comment          String?
  reviewedByUserId String               @map("reviewed_by_user_id") @db.Uuid
  reviewedAt       DateTime             @map("reviewed_at")

  clause   ContractClause @relation(fields: [clauseId, tenantId, customerId], references: [id, tenantId, customerId], map: "clause_reviews_clause_fk", onDelete: NoAction, onUpdate: NoAction)
  contract Contract       @relation(fields: [contractId, tenantId, customerId], references: [id, tenantId, customerId], map: "clause_reviews_contract_fk", onDelete: NoAction, onUpdate: NoAction)

  @@index([tenantId, customerId, clauseId], map: "clause_reviews_clause_idx")
  @@map("contract_clause_reviews")
}

/// Annexe d'une version de contrat (SLA, actifs, grille tarifaire, DPA art. 28…).
model Annex {
  id         String    @id @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  customerId String    @map("customer_id") @db.Uuid
  contractId String    @map("contract_id") @db.Uuid
  versionId  String    @map("version_id") @db.Uuid
  position   Int
