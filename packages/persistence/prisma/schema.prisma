  @@unique([tenantId, versionNumber], map: "proposal_terms_version_key")
  @@unique([id, tenantId], map: "proposal_terms_scope_key")
  @@map("proposal_terms")
}

/// Modèle de proposition (annexe C). `signedProposalIsContract` : désactivé par défaut, à valider par un juriste.
model ProposalTemplate {
  id                       String                 @id @db.Uuid
  tenantId                 String                 @map("tenant_id") @db.Uuid
  slug                     String
  name                     String
  description              String
  target                   String
  contractTemplateSlug     String                 @map("contract_template_slug")
  acceptanceMode           ProposalAcceptanceMode @map("acceptance_mode")
  providerCountersign      Boolean                @default(true) @map("provider_countersign")
  validityDays             Int                    @default(30) @map("validity_days")
  /// { noOpenAfterDays, noDecisionAfterDays, beforeExpiryDays }
  followUps                Json                   @map("follow_ups")
  vatRatePercent           Decimal                @map("vat_rate_percent") @db.Decimal(5, 2)
  currency                 String                 @default("EUR") @db.Char(3)
  tags                     String[]               @default([])
  /// Choice[] (schema.ts de l'annexe C)
  pricingChoices           Json                   @map("pricing_choices")
  /// Rule[] — évaluées par le moteur de tarification, jamais par l'interface.
  pricingRules             Json                   @map("pricing_rules")
  controlCases             Json?                  @map("control_cases")
  signedProposalIsContract Boolean                @default(false) @map("signed_proposal_is_contract")
  seedVersion              Int?                   @map("seed_version")
  seedChecksum             String?                @map("seed_checksum") @db.Char(64)
  userModifiedAt           DateTime?              @map("user_modified_at")
  archivedAt               DateTime?              @map("archived_at")
  createdAt                DateTime               @map("created_at")
  updatedAt                DateTime               @map("updated_at")

  tenant    Tenant                        @relation(fields: [tenantId], references: [id], map: "proposal_templates_tenant_id_fkey", onDelete: NoAction, onUpdate: NoAction)
