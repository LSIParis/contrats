/// IMMUABLE (UPDATE/DELETE révoqués) : les modèles et contrats pointent une version précise.
model ClauseLibraryItemVersion {
  id              String   @id @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  itemId          String   @map("item_id") @db.Uuid
