  lines     ProposalTemplatePricingLine[]
  proposals Proposal[]

  @@unique([tenantId, slug], map: "proposal_templates_slug_key")
  @@unique([id, tenantId], map: "proposal_templates_scope_key")
  @@map("proposal_templates")
}

model ProposalTemplateSection {
