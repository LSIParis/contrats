/// Valeur publiée d'un indice. APPEND-ONLY (UPDATE/DELETE révoqués) : une
/// correction est une nouvelle ligne `supersedes` la précédente (révision + 1).
/// La valeur retenue pour une période est la pointe de la chaîne.
model PriceIndexValue {
  id              String                @id @db.Uuid
  tenantId        String                @map("tenant_id") @db.Uuid
  indexId         String                @map("index_id") @db.Uuid
  /// « YYYY-MM »
  period          String                @db.Char(7)
  value           Decimal               @db.Decimal(18, 6)
  publishedAt     DateTime              @map("published_at") @db.Date
  source          PriceIndexValueSource
  /// 0 = valeur originale ; n = n-ième correction.
  revision        Int                   @default(0)
  supersedesId    String?               @unique(map: "price_index_values_supersedes_key") @map("supersedes_id") @db.Uuid
  correctionReason String?              @map("correction_reason")
  enteredByUserId String?               @map("entered_by_user_id") @db.Uuid
  createdAt       DateTime              @map("created_at")

  index        PriceIndex       @relation(fields: [indexId, tenantId], references: [id, tenantId], map: "price_index_values_index_fk", onDelete: NoAction, onUpdate: NoAction)
  supersedes   PriceIndexValue? @relation("IndexValueCorrection", fields: [supersedesId, tenantId, indexId, period], references: [id, tenantId, indexId, period], map: "price_index_values_supersedes_fk", onDelete: NoAction, onUpdate: NoAction)
  supersededBy PriceIndexValue[] @relation("IndexValueCorrection")

  @@unique([id, tenantId, indexId, period], map: "price_index_values_chain_key")
  @@unique([indexId, period, revision], map: "price_index_values_revision_key")
  @@map("price_index_values")
}

