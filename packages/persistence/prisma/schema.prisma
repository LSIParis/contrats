/// Composition d'une version de modèle : clauses de bibliothèque ÉPINGLÉES.
model TemplateClause {
  tenantId          String  @map("tenant_id") @db.Uuid
  templateVersionId String  @map("template_version_id") @db.Uuid
  position          Int
  clauseVersionId   String  @map("clause_version_id") @db.Uuid
