  contract Contract        @relation(fields: [contractId, tenantId, customerId], references: [id, tenantId, customerId], map: "annexes_contract_fk", onDelete: NoAction, onUpdate: NoAction)

  @@unique([versionId, position], map: "annexes_position_key")
  @@index([tenantId, customerId, contractId], map: "annexes_contract_idx")
