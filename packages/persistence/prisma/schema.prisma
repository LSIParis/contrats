  @@id([tenantId, year], map: "proposal_sequences_pkey")
  @@map("proposal_sequences")
}

/// Proposition commerciale. Statut écrit EXCLUSIVEMENT via persistProposalTransition
/// (journal proposal_lifecycle_events + audit chaîné par trigger).
model Proposal {
  id                       String                 @id @db.Uuid
  tenantId                 String                 @map("tenant_id") @db.Uuid
  customerId               String                 @map("customer_id") @db.Uuid
  number                   String
  title                    String
  templateId               String?                @map("template_id") @db.Uuid
  ownerUserId              String                 @map("owner_user_id") @db.Uuid
  status                   ProposalStatus         @default(DRAFT)
  acceptanceMode           ProposalAcceptanceMode @default(DOCUSEAL_SIGNATURE) @map("acceptance_mode")
  currentVersionId         String?                @map("current_version_id") @db.Uuid
  validityDays             Int                    @default(30) @map("validity_days")
  fixedExpiryDate          DateTime?              @map("fixed_expiry_date") @db.Date
  expiresAt                DateTime?              @map("expires_at")
  sensitive                Boolean                @default(false)
  reviewRequired           Boolean                @default(false) @map("review_required")
  reviewSubmittedByUserId  String?                @map("review_submitted_by_user_id") @db.Uuid
  reviewApprovedVersionId  String?                @map("review_approved_version_id") @db.Uuid
  reviewDecidedByUserId    String?                @map("review_decided_by_user_id") @db.Uuid
  reviewReason             String?                @map("review_reason")
  acceptedVersionId        String?                @map("accepted_version_id") @db.Uuid
  acceptedSnapshotId       String?                @map("accepted_snapshot_id") @db.Uuid
  followUpsEnabled         Boolean                @default(true) @map("follow_ups_enabled")
  followUpConfig           Json?                  @map("follow_up_config")
  mergeContext             Json                   @default("{}") @map("merge_context")
  winProbability           Int?                   @map("win_probability")
  oneTimeCents             BigInt?                @map("one_time_cents")
  monthlyCents             BigInt?                @map("monthly_cents")
  commitmentTotalCents     BigInt?                @map("commitment_total_cents")
  commitmentMonths         Int?                   @map("commitment_months")
  signedProposalIsContract Boolean                @default(false) @map("signed_proposal_is_contract")
  /// Date d'effet souhaitée, reprise par le contrat généré (migration 32).
  desiredStartDate         DateTime?              @map("desired_start_date") @db.Date
  /// Dernière erreur de conversion (contrat type introuvable…), retentée par le job.
  conversionError          String?                @map("conversion_error")
  declineReasonCode        String?                @map("decline_reason_code")
  declineReason            String?                @map("decline_reason")
  withdrawReason           String?                @map("withdraw_reason")
  /// Contrat généré (traçabilité proposition → contrat).
  contractId               String?                @map("contract_id") @db.Uuid
  sentAt                   DateTime?              @map("sent_at")
  firstViewedAt            DateTime?              @map("first_viewed_at")
  lastActivityAt           DateTime?              @map("last_activity_at")
  clientRespondedAt        DateTime?              @map("client_responded_at")
  acceptedAt               DateTime?              @map("accepted_at")
  signedAt                 DateTime?              @map("signed_at")
  convertedAt              DateTime?              @map("converted_at")
  declinedAt               DateTime?              @map("declined_at")
  expiredAt                DateTime?              @map("expired_at")
  withdrawnAt              DateTime?              @map("withdrawn_at")
  createdAt                DateTime               @map("created_at")
  updatedAt                DateTime               @map("updated_at")
  createdByUserId          String                 @map("created_by_user_id") @db.Uuid
  updatedByUserId          String                 @map("updated_by_user_id") @db.Uuid

  customer Customer          @relation(fields: [customerId, tenantId], references: [id, tenantId], map: "proposals_customer_fk", onDelete: NoAction, onUpdate: NoAction)
  template ProposalTemplate? @relation(fields: [templateId, tenantId], references: [id, tenantId], map: "proposals_template_fk", onDelete: NoAction, onUpdate: NoAction)
  owner    User              @relation("ProposalOwner", fields: [ownerUserId, tenantId], references: [id, tenantId], map: "proposals_owner_fk", onDelete: NoAction, onUpdate: NoAction)
  contract Contract?         @relation("ProposalGeneratedContract", fields: [contractId, tenantId, customerId], references: [id, tenantId, customerId], map: "proposals_contract_fk", onDelete: NoAction, onUpdate: NoAction)

  contractsFromProposal Contract[]               @relation("ContractFromProposal")
  lifecycleEvents       ProposalLifecycleEvent[]
  versions              ProposalVersion[]
  recipients            ProposalRecipient[]
  viewStats             ProposalViewStat[]
  followUps             ProposalFollowUp[]
  storedDocuments       StoredDocument[]

  @@unique([id, tenantId, customerId], map: "proposals_scope_key")
  @@unique([tenantId, number], map: "proposals_number_key")
  @@index([tenantId, status], map: "proposals_status_idx")
  @@index([tenantId, customerId], map: "proposals_customer_idx")
  @@index([tenantId, ownerUserId, status], map: "proposals_owner_idx")
  @@index([status, expiresAt], map: "proposals_expiry_idx")
  @@map("proposals")
}

/// Écrit EXCLUSIVEMENT par le trigger `proposals_status_transition` (INSERT/UPDATE/DELETE révoqués).
model ProposalLifecycleEvent {
  id          String          @id @db.Uuid
  tenantId    String          @map("tenant_id") @db.Uuid
  customerId  String          @map("customer_id") @db.Uuid
  proposalId  String          @map("proposal_id") @db.Uuid
  fromStatus  ProposalStatus? @map("from_status")
  toStatus    ProposalStatus  @map("to_status")
  event       String?
  reason      String?
  actorUserId String?         @map("actor_user_id") @db.Uuid
  actorKind   ActorKind       @map("actor_kind")
  occurredAt  DateTime        @map("occurred_at")
  seq         BigInt          @default(autoincrement())

  proposal Proposal @relation(fields: [proposalId, tenantId, customerId], references: [id, tenantId, customerId], map: "proposal_lifecycle_events_proposal_fk", onDelete: NoAction, onUpdate: NoAction)

  @@index([tenantId, customerId, proposalId, seq], map: "proposal_lifecycle_events_proposal_idx")
  @@map("proposal_lifecycle_events")
}

/// Version : IMMUABLE dès l'envoi (`lockedAt`, trigger). Toute modification crée une nouvelle version.
