/// Ligne de barème. `lineKey` est STABLE d'une version à l'autre (c'est le
/// `lineId` du moteur, et la cible des dérogations).
model PricingLine {
  id                  String                @id @db.Uuid
  tenantId            String                @map("tenant_id") @db.Uuid
  customerId          String                @map("customer_id") @db.Uuid
