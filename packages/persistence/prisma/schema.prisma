  objectKey        String               @unique @map("object_key")
  filename         String
  contentType      String               @map("content_type")
  sizeBytes        BigInt               @map("size_bytes")
  /// Empreinte du fichier tel que reçu/produit : fonde la valeur probante.
  sha256           String               @db.Char(64)
  /// Copie OCR → original dont elle dérive.
  derivedFromId    String?              @map("derived_from_id") @db.Uuid
  uploadedByUserId String?              @map("uploaded_by_user_id") @db.Uuid
  createdAt        DateTime             @map("created_at")
