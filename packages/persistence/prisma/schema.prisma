/// Contenu réutilisable. `userModifiedAt` : modifié dans l'interface → le seed ne le réécrit plus.
model ContentLibraryItem {
  id                  String    @id @db.Uuid
  tenantId            String    @map("tenant_id") @db.Uuid
  key                 String
  title               String
  folder              String
  body                String
  requiresLegalReview Boolean   @default(false) @map("requires_legal_review")
  /// Incrémenté à chaque modification ; le texte est figé dans chaque version envoyée.
  version             Int       @default(1)
  seedVersion         Int?      @map("seed_version")
  seedChecksum        String?   @map("seed_checksum") @db.Char(64)
  userModifiedAt      DateTime? @map("user_modified_at")
  archivedAt          DateTime? @map("archived_at")
  createdAt           DateTime  @map("created_at")
  updatedAt           DateTime  @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], map: "content_library_items_tenant_id_fkey", onDelete: NoAction, onUpdate: NoAction)

  @@unique([tenantId, key], map: "content_library_items_key_key")
  @@unique([id, tenantId], map: "content_library_items_scope_key")
  @@index([tenantId, folder], map: "content_library_items_folder_idx")
  @@map("content_library_items")
}

/// CGV versionnées, IMMUABLES (UPDATE/DELETE révoqués). Chaque version de proposition en référence une.
