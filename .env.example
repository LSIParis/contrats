# Copier en .env — .env est git-ignoré (§13.5 : jamais de secret dans le dépôt).
#
# Aucune de ces valeurs n'est utilisable en production. La production injecte
# ses secrets depuis AWS Secrets Manager à l'exécution, jamais par variable
# d'environnement figée dans une image.

# --- Base de données ---------------------------------------------------
# Propriétaire du schéma : MIGRATIONS UNIQUEMENT.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/lsi_contrats"

# Rôle applicatif : non-propriétaire, sans BYPASSRLS (§10.3).
# C'est CELUI-CI que l'application utilise. Utiliser DATABASE_URL à la place
# désactiverait de fait tout le cloisonnement.
DATABASE_URL_APP="postgresql://lsi_app:lsi_app_test_pwd@localhost:5433/lsi_contrats"

# Rôle de résolution de scope des webhooks : six colonnes, lecture seule (§11.4).
DATABASE_URL_WEBHOOK="postgresql://lsi_webhook:lsi_webhook_test_pwd@localhost:5433/lsi_contrats"

# Rôle de découverte des rappels : trois colonnes, lecture seule (§12.3).
DATABASE_URL_SCHEDULER="postgresql://lsi_scheduler:lsi_scheduler_test_pwd@localhost:5433/lsi_contrats"

# --- Redis -------------------------------------------------------------
REDIS_URL="redis://localhost:6380"

# --- DocuSeal ----------------------------------------------------------
DOCUSEAL_URL="http://localhost:3002/api"

# À créer dans l'interface DocuSeal (Settings → API) au premier démarrage.
# ⚠ Cette clé est AUSSI le secret de signature JWT : la divulguer compromet
# les deux (§11.7).
DOCUSEAL_API_KEY=""

# Secret du webhook, à configurer dans DocuSeal (Settings → Webhooks).
# Sans lui, verifyWebhook() lève : c'est voulu. Un secret absent ne doit
# jamais faire passer la vérification (§11.7).
DOCUSEAL_WEBHOOK_SECRET="dev-webhook-secret-change-me"

# ⚠ R6 — nom d'en-tête À CONFIRMER contre l'instance réelle.
# La doc DocuSeal impose la vérification HMAC sans nommer l'en-tête pour
# l'auto-hébergé. Surchargeable ici précisément parce que je n'ai pas pu
# le vérifier.
DOCUSEAL_SIGNATURE_HEADER="x-docuseal-signature"

# --- Rendu documentaire ------------------------------------------------
GOTENBERG_URL="http://localhost:3003"

# --- Stockage ----------------------------------------------------------
S3_ENDPOINT="http://localhost:9000"
S3_BUCKET="lsi-contrats-dev"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_REGION="eu-west-3"

# --- Emails ------------------------------------------------------------
SMTP_HOST="localhost"
SMTP_PORT="1025"
# Interface Mailpit : http://localhost:8025

# --- Application -------------------------------------------------------
PORT="3001"
APP_ORIGIN="http://localhost:3000"
PORTAL_URL="http://localhost:3000"

# --- Ports du compose (surchargeables en cas de conflit) ----------------
POSTGRES_PORT="5433"
REDIS_PORT="6380"
DOCUSEAL_PORT="3002"
GOTENBERG_PORT="3003"
MINIO_PORT="9000"
MINIO_CONSOLE_PORT="9001"
MAILPIT_SMTP_PORT="1025"
MAILPIT_UI_PORT="8025"
