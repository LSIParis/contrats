{
  "name": "@lsi/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "start": "node --import @swc-node/register/esm-register src/main.ts",
    "start:dev": "node --watch --import @swc-node/register/esm-register src/main.ts",
    "start:worker": "node --import @swc-node/register/esm-register src/worker.ts",
    "test:ci": "vitest run --coverage --coverage.reporter=text-summary --coverage.reporter=lcov --coverage.reportsDirectory=../../coverage/api",
    "openapi:generate": "node --import @swc-node/register/esm-register scripts/generate-openapi.ts",
    "openapi:check": "node --import @swc-node/register/esm-register scripts/generate-openapi.ts --check"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@aws-sdk/client-s3": "^3.1159.0",
    "@aws-sdk/s3-request-presigner": "^3.1159.0",
    "@fastify/cookie": "^11.1.5",
    "@fastify/multipart": "^10.1.6",
    "@fastify/static": "^10.1.8",
    "@lsi/domain": "workspace:*",
    "@lsi/persistence": "workspace:*",
    "@lsi/pricing": "workspace:*",
    "@nestjs/common": "^11.2.8",
    "@nestjs/core": "^11.2.8",
    "@nestjs/platform-fastify": "^11.2.8",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.16.20",
    "@turbodocx/html-to-docx": "^1.23.1",
    "bullmq": "^5.80.8",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "fastify": "5.12.7",
    "ioredis": "^5.11.1",
    "nestjs-pino": "^5.3.1",
    "openid-client": "^6.8.8",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sanitize-html": "^2.18.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.8",
    "@testcontainers/postgresql": "^10.28.0",
    "@testcontainers/redis": "^12.1.0",
    "@types/node": "^26.0.0",
    "@types/sanitize-html": "^2.16.2",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.0",
    "testcontainers": "^10.13.2",
    "typescript": "^5.6.3",
    "unplugin-swc": "^1.5.9",
    "vitest": "^2.1.5",
    "yaml": "2.9.1"
  }
}
