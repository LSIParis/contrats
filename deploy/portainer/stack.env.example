# =============================================================================
# Variables de la stack Portainer « contrats » — MODÈLE, AUCUNE VALEUR RÉELLE
#
# À saisir dans Portainer → Stacks → contrats → Environment variables
# (mode « Advanced » : coller ce fichier rempli). JAMAIS commité une fois rempli
# (`stack.env` est ignoré par .gitignore et .dockerignore).
#
# Légende : [REQUIS] la stack refuse de démarrer sans (`${VAR:?}`),
#           [SECRET] ne doit apparaître ni dans le dépôt ni dans un ticket,
#           [défaut: x] valeur utilisée si la variable est absente.
#
# Générer un secret : openssl rand -base64 48 | tr -d '/+=' | cut -c1-40
# (pas d'apostrophe ni de barre oblique inverse : les mots de passe de rôles
#  sont interpolés en SQL par deploy/migrate.sh, qui les refuse sinon).
# Procédure complète : docs/contrats/09-exploitation.md
# =============================================================================

# --- Images ------------------------------------------------------------------
# [REQUIS] Propriétaire GHCR, EN MINUSCULES (GitHub : LSIParis → lsiparis).
GHCR_OWNER=lsiparis
# [REQUIS] Tag de l'image applicative (app, worker, migrate).
#   production    : version épinglée X.Y.Z (ex. 1.4.2) — JAMAIS latest
#   préproduction : main
# Retour arrière = remettre la version précédente ici, puis redéployer.
CONTRATS_TAG=0.0.0
# [défaut: CONTRATS_TAG] Tags des images annexes (publiées par
# .github/workflows/images-annexes.yml avec le même schéma de tags).
# À fixer si l'image annexe de la version visée n'a pas été publiée.
OCR_TAG=
BACKUP_TAG=
# [REQUIS] Image MinIO : miroir GHCR privé de l'image officielle déjà en cache
# sur le VPS (MinIO ne publie plus d'images publiques). Voir 09-exploitation.md §MinIO.
MINIO_IMAGE=ghcr.io/lsiparis/minio:RELEASE.2025-09-07T16-13-09Z

# --- Exposition --------------------------------------------------------------
# [REQUIS] URL publique (sans / final). Préproduction : https://contrats-preprod.lsi-maintenance.fr
APP_URL=https://contrats.lsi-maintenance.fr
# [défaut: APP_URL] Origine CORS autorisée et URL du portail client.
APP_ORIGIN=
PORTAL_URL=
# [défaut: 127.0.0.1] Adresse de l'hôte sur laquelle `app` est publié.
#   127.0.0.1  : reverse proxy sur ce VPS (51.178.30.81)
#   10.99.0.2  : reverse proxy sur 51.91.98.38, joint par le tunnel WireGuard
#   Ne JAMAIS mettre 0.0.0.0 (l'API serait joignable en clair sans TLS).
APP_BIND_IP=127.0.0.1
# [défaut: 3001] Port de l'hôte. Préproduction sur le même VPS : 3011 par ex.
APP_PORT=3001
# [défaut: 1] Proxy de confiance pour X-Forwarded-For/-Proto/-Host :
#   nombre de sauts (1 = un seul reverse proxy devant l'app) ou liste
#   d'IP/CIDR (ex. 127.0.0.1 ; 10.99.0.1 pour le proxy via WireGuard).
TRUST_PROXY=1
# [défaut: info] Niveau de log (fatal, error, warn, info, debug). Jamais debug en production.
LOG_LEVEL=info

# --- PostgreSQL --------------------------------------------------------------
# [défaut: lsi_contrats] Nom de la base.
POSTGRES_DB=lsi_contrats
# [REQUIS][SECRET] Superutilisateur : utilisé UNIQUEMENT par migrate et backup.
POSTGRES_SUPERUSER_PASSWORD=
# [REQUIS][SECRET] Mots de passe des rôles applicatifs (RLS), posés par migrate.sh.
LSI_APP_PASSWORD=
LSI_WEBHOOK_PASSWORD=
LSI_SCHEDULER_PASSWORD=

# --- Redis -------------------------------------------------------------------
# [REQUIS][SECRET]
REDIS_PASSWORD=

# --- Stockage documentaire (MinIO) -------------------------------------------
# [défaut: lsi-contrats] Bucket (créé et versionné par minio-init).
S3_BUCKET=lsi-contrats
# [REQUIS][SECRET] Identifiants racine MinIO, réutilisés par l'app (S3).
S3_ACCESS_KEY=
S3_SECRET_KEY=
# [défaut: eu-west-3] Région annoncée au SDK S3 (sans effet sur MinIO).
S3_REGION=eu-west-3

# --- DocuSeal Pro ------------------------------------------------------------
# [REQUIS] URL de l'API DocuSeal (avec /api).
DOCUSEAL_URL=https://signe.lsi-maintenance.fr/api
# [REQUIS][SECRET] Clé d'API (DocuSeal → Settings → API). Elle signe aussi les JWT.
DOCUSEAL_API_KEY=
# [REQUIS][SECRET] Secret HMAC du webhook (DocuSeal → Settings → Webhooks, whsec_…).
DOCUSEAL_WEBHOOK_SECRET=
# [défaut: x-docuseal-signature] En-tête portant la signature HMAC.
DOCUSEAL_SIGNATURE_HEADER=x-docuseal-signature
# [SECRET][facultatif] En-tête secret supplémentaire du webhook (hypothèse V2-H6).
DOCUSEAL_WEBHOOK_HEADER_SECRET=

# --- IA (facultatif : sans clé, les fonctions IA répondent 503) --------------
# [SECRET] Agent API de Perplexity (rédaction assistée, texte pseudonymisé).
PERPLEXITY_API_KEY=
# [SECRET] Adaptateur Claude conservé (choix par tenant).
ANTHROPIC_API_KEY=

# --- Webhooks sortants (docs/contrats/07-api.md, 08-securite-rgpd.md) --------
# [REQUIS][SECRET] Clé AES-256-GCM qui chiffre les secrets HMAC des abonnements
# (32 octets, base64 ou 64 hex) : openssl rand -base64 32. La perdre rend les
# secrets indéchiffrables (il faudrait les faire tous tourner).
WEBHOOK_SECRET_KEY=
# [défaut: 1] Numéro de la clé courante. Rotation : l'ancienne clé passe dans
# WEBHOOK_SECRET_KEY_V<n>, la nouvelle dans WEBHOOK_SECRET_KEY, n+1 ici.
WEBHOOK_SECRET_KEY_VERSION=1
# [SECRET][facultatif] Ancienne clé n°1, le temps d'une rotation.
WEBHOOK_SECRET_KEY_V1=
# [défaut: false] true = autorise http:// et les destinations privées/locales
# (protection SSRF levée). Uniquement pour un consommateur sur le réseau privé.
WEBHOOKS_ALLOW_PRIVATE=false
# [défaut: 20] Livraisons en échec définitif consécutives avant désactivation
# automatique d'un abonnement.
WEBHOOKS_DISABLE_AFTER_DEAD=20

# --- Authentification ----------------------------------------------------------
# [défaut: lsi] Tenant par défaut.
DEFAULT_TENANT_SLUG=lsi
# [REQUIS] OIDC Entra ID (Microsoft 365) pour les utilisateurs internes.
OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
OIDC_CLIENT_ID=
# [REQUIS][SECRET]
OIDC_CLIENT_SECRET=
# [SECRET][facultatif] Clé X-Api-Key de l'application de ticketing (openssl rand -hex 32).
CONTRACT_SERVICE_API_KEY=

# --- E-mails -----------------------------------------------------------------
# [SECRET][facultatif] Clé d'API Brevo (sans elle, pas d'envoi d'e-mail).
BREVO_API_KEY=
# [défaut: contrats@lsi-maintenance.fr]
EMAIL_FROM=contrats@lsi-maintenance.fr
# [défaut: LSI Maintenance]
EMAIL_FROM_NAME=LSI Maintenance

# --- OCR -----------------------------------------------------------------------
# [défaut: 52428800] Taille max d'un PDF envoyé à l'OCR (octets). Aligner le
# client_max_body_size du reverse proxy au-dessus (≥ 60m).
OCR_MAX_BYTES=52428800
# [défaut: 300] Délai maximal d'un OCR (secondes).
OCR_TIMEOUT_SECONDS=300
# [défaut: 2] OCR simultanés (au-delà : 503, le worker réessaie).
OCR_MAX_CONCURRENCY=2
# [défaut: 1g] Taille du tmpfs /tmp du conteneur OCR (≥ 10 × OCR_MAX_BYTES conseillé si scans lourds).
OCR_TMPFS_SIZE=1g

# --- Sauvegardes (hors VPS : Wasabi) -----------------------------------------
# [défaut: Europe/Paris] Fuseau du planificateur (sauvegarde 02h00, contrôle le 1er à 03h00).
TZ=Europe/Paris
# [défaut: https://s3.eu-west-2.wasabisys.com] Point d'accès Wasabi (Paris).
WASABI_ENDPOINT=https://s3.eu-west-2.wasabisys.com
# [REQUIS] Bucket Wasabi (versioning + object lock).
WASABI_BUCKET=lsi-contrats
# [REQUIS][SECRET] Clé d'accès dédiée à ce bucket, droits minimaux.
WASABI_ACCESS_KEY=
WASABI_SECRET_KEY=
# [SECRET][fortement conseillé] URL « push » Uptime Kuma : heartbeat de sauvegarde réussie.
UPTIME_PUSH_URL=
# [SECRET][facultatif] URL « push » Uptime Kuma : restauration de contrôle réussie.
UPTIME_RESTORE_PUSH_URL=

# --- Limites mémoire (facultatif) ----------------------------------------------
# Valeurs par défaut adaptées à un VPS de 8 Go partagé.
POSTGRES_MEM_LIMIT=1g
REDIS_MEM_LIMIT=256m
MINIO_MEM_LIMIT=512m
GOTENBERG_MEM_LIMIT=1g
OCR_MEM_LIMIT=2g
APP_MEM_LIMIT=1g
WORKER_MEM_LIMIT=1g
BACKUP_MEM_LIMIT=512m
